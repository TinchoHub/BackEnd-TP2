extends layout

block contenido

  h2 Detalle del cliente

  if cliente

    section.detalle-card
      h3 #{cliente.nombre} #{cliente.apellido}

      p
        strong ID:
        |  #{cliente.id}

      p
        strong Teléfono:
        |  #{cliente.telefono}

      p
        strong Email:
        |  #{cliente.email}

      .acciones-detalle
        button.boton-eliminar(
          type="button"
          onclick=`eliminarCliente(${cliente.id})`
        ) Eliminar cliente

        a.volver(href="/clientes") Volver a clientes

  else

    p Cliente no encontrado.