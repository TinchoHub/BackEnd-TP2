extends layout

block contenido

  h2 Detalle del cliente

  if cliente

    section.detalle-card
      h3 #{cliente.nombre} #{cliente.apellido}

      p
        strong ID:
        |  #{cliente._id}

      p
        strong Teléfono:
        |  #{cliente.telefono}

      p
        strong Email:
        |  #{cliente.email}

      .acciones-detalle
        a.boton(href="/clientes/" + cliente._id + "/editar") Modificar cliente

        button.boton-eliminar(
          type="button"
          onclick=`eliminarCliente('${cliente._id}')`
        ) Eliminar cliente

        a.volver(href="/clientes") Volver a clientes

  else

    p Cliente no encontrado.