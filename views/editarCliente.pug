
extends layout

block contenido

  .page-header
    .page-header__info
      h2 Modificar cliente
      p Actualizá los datos del cliente registrado en AutoBox.

  if cliente

    section.detalle-card
      form(method="POST" action="/clientes/" + cliente.id + "/editar")

        .form-group
          label(for="nombre") Nombre
          input#nombre(
            type="text"
            name="nombre"
            value=cliente.nombre
            required
          )

        .form-group
          label(for="apellido") Apellido
          input#apellido(
            type="text"
            name="apellido"
            value=cliente.apellido
            required
          )

        .form-group
          label(for="telefono") Teléfono
          input#telefono(
            type="text"
            name="telefono"
            value=cliente.telefono
            required
          )

        .form-group
          label(for="email") Email
          input#email(
            type="email"
            name="email"
            value=cliente.email
            required
          )

        .acciones-detalle
          button.boton(type="submit") Guardar cambios
          a.volver(href="/clientes") Cancelar

  else
    p Cliente no encontrado.
    a.volver(href="/clientes") Volver a clientes
