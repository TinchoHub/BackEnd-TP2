extends layout

block contenido
  .page-header
    .page-header__info
      .page-header__icon
        svg(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
          path(d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2")
          circle(cx="8.5" cy="7" r="4")
          line(x1="20" y1="8" x2="20" y2="14")
          line(x1="23" y1="11" x2="17" y2="11")
      div
        h2 Alta de Usuario
        p Registro de operadores y administradores para AutoBox

  if error
    .socket-toast(style="position: static; margin-bottom: 20px; background: #b42318; border-color: #ff8a3d;")
      p= error

  form(action="/usuarios" method="POST")
    .campo
      label(for="nombre") Nombre Completo
      input#nombre(type="text" name="nombre" required minlength="2" placeholder="Ej: Carlos Gómez" value=valores ? valores.nombre : '')

    .campo
      label(for="username") Nombre de Usuario (login)
      input#username(type="text" name="username" required minlength="3" placeholder="Ej: cgomez" value=valores ? valores.username : '')

    .campo
      label(for="password") Contraseña
      input#password(type="password" name="password" required minlength="6" placeholder="Mínimo 6 caracteres")

    .campo
      label(for="rol") Rol de Acceso
      select#rol(name="rol" required)
        option(value="operador" selected=(!valores || valores.rol === 'operador')) Operador (Mecánico / Recepción)
        option(value="admin" selected=(valores && valores.rol === 'admin')) Administrador (Acceso total)

    button.btn.btn--primary(type="submit") Guardar Usuario