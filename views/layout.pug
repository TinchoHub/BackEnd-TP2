doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title AutoBox
    link(rel="stylesheet" href="/css/styles.css")

  body
    .app

      aside.sidebar

        .sidebar__logo
          img(src="/img/autobox-logo.png" alt="AutoBox")

        nav.sidebar__nav

          a(href="/")
            svg.nav-icon(
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            )
              path(d="M3 11L12 4l9 7")
              path(d="M5 10v10h14V10")
              path(d="M9 20v-6h6v6")

            span Inicio

          a(href="/clientes")
            svg.nav-icon(
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            )
              circle(cx="12" cy="8" r="4")
              path(d="M4 21c0-4 3.5-7 8-7s8 3 8 7")

            span Clientes

          a(href="/vehiculos")
            svg.nav-icon(
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            )
              path(d="M5 17h14")
              path(d="M6 17l-1-5 2-5h10l2 5-1 5")
              circle(cx="7" cy="17" r="2")
              circle(cx="17" cy="17" r="2")

            span Vehículos

          a(href="/turnos")
            svg.nav-icon(
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            )
              rect(x="3" y="5" width="18" height="16" rx="2")
              path(d="M16 3v4M8 3v4M3 10h18")
              path(d="M8 14h2M12 14h2M16 14h2M8 17h2M12 17h2")

            span Turnos

        .sidebar__footer
          p Tu vehículo
          strong EN BUENAS MANOS

      .contenido
        block contenido

    script(src="/js/main.js")