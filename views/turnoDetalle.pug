
extends layout

block contenido

  h2 Detalle del turno

  if turno

    section.detalle-card
      h3 #{turno.servicio}

      p
        strong ID:
        |  #{turno._id}

      p
        strong Cliente:
        if turno.clienteId
          |  #{turno.clienteId.nombre} #{turno.clienteId.apellido}
        else
          |  Cliente no disponible

      p
        strong Vehículo:
        if turno.vehiculoId
          |  #{turno.vehiculoId.marca} #{turno.vehiculoId.modelo}
        else
          |  Vehículo no disponible

      p
        strong Patente:
        if turno.vehiculoId
          |  #{turno.vehiculoId.patente}
        else
          |  No disponible

      p
        strong Fecha:
        |  #{turno.fecha}

      p
        strong Hora:
        |  #{turno.hora}

      p
        strong Servicio:
        |  #{turno.servicio}

      .acciones-detalle
        button.boton-eliminar(
          type="button"
          onclick=`cancelarTurno('${turno._id}')`
        ) Cancelar turno

        a.volver(href="/turnos") Volver a turnos

  else

    p Turno no encontrado.
