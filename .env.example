# Copiar a .env y completar. No subir .env al repositorio.
PORT=3000
NODE_ENV=development

# Local: mongodb://127.0.0.1:27017/autobox  |  Atlas: mongodb+srv://usuario:clave@cluster.mongodb.net/autobox
MONGODB_URI=mongodb://127.0.0.1:27017/autobox

# Clave para firmar los JWT (usar una cadena larga y aleatoria)
JWT_SECRET=reemplazar-por-una-clave-larga-y-aleatoria

# Asesor técnico con IA (Gemini)
GEMINI_API_KEY=
# Opcional: nombre del modelo si se quiere cambiar
# GEMINI_MODEL=

# Primer administrador (lo usa: npm run seed)
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=cambiar-esta-clave
SEED_ADMIN_NAME=Administrador
